<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Author>Virsta</Author>
    <Name>SunAway</Name>
    <MinimumDalamudVersion>14.0.0</MinimumDalamudVersion>
    <Version>0.1.0</Version>
    <ApplicableVersion>any</ApplicableVersion>
    <Punchline>Removes the sun while you're indoors.</Punchline>
    <Description>Automatically turns off the game's glare while you are inside a housing interior, so the sun stops blasting through the walls. Your graphics settings are restored the moment you step back outside.</Description>
    <RepoUrl>https://github.com/VirstaXIV/SunAway</RepoUrl>
    <PackageProjectUrl>https://github.com/VirstaXIV/SunAway</PackageProjectUrl>
    <Tags>sun;glare;indoors;housing;lighting</Tags>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
