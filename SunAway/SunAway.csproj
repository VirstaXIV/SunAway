<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Author>Virsta</Author>
    <Name>SunAway</Name>
    <MinimumDalamudVersion>14.0.0</MinimumDalamudVersion>
    <Version>0.3.2</Version>
    <ApplicableVersion>any</ApplicableVersion>
    <Punchline>Removes the sun while you're indoors.</Punchline>
    <Description>Gets rid of the void sun — the sun that shines through the walls while you are inside a housing interior. Everything is back to normal the moment you step outside.</Description>
    <RepoUrl>https://github.com/VirstaXIV/SunAway</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/VirstaXIV/SunAway/master/images/icon.png</IconUrl>
    <PackageProjectUrl>https://github.com/VirstaXIV/SunAway</PackageProjectUrl>
    <Tags>sun;glare;indoors;housing;lighting</Tags>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
